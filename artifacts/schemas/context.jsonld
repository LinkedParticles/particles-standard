{
  "@context": {
    "particles": "https://linkedparticles.org/vocab#",
    "extraction": "https://linkedparticles.org/vocab/extraction#",
    "psum": "https://www.omg.org/spec/PSUM/1.0/",
    "prov": "http://www.w3.org/ns/prov#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "nmo": "http://nomisma.org/ontology#",
    "nuds": "http://nomisma.org/nuds#",
    "nm": "http://nomisma.org/id/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#",
    "schema": "https://schema.org/",
    "dc": "http://purl.org/dc/terms/",
    "wd": "http://www.wikidata.org/entity/",
    "wdt": "http://www.wikidata.org/prop/direct/",
    "social": "https://linkedparticles.org/vocab/social#",
    "thread": "https://linkedparticles.org/vocab/thread#",
    "hn": "https://linkedparticles.org/vocab/hn#",
    "mastodon": "https://linkedparticles.org/vocab/mastodon#",
    "numista": "https://linkedparticles.org/vocab/numista#",

    "Particle": "particles:Particle",
    "Subject": "particles:Subject",
    "CorpusEntry": "particles:CorpusEntry",
    "Snapshot": "particles:Snapshot",
    "SourceTrustStatement": "particles:SourceTrustStatement",
    "SourceRef": "particles:SourceRef",
    "ProvenanceRef": "particles:ProvenanceRef",
    "ExternalRef": "particles:ExternalRef",
    "ParticleRelation": "particles:ParticleRelation",
    "ReviewParticle": "particles:ReviewParticle",
    "ContributorRef": "particles:ContributorRef",
    "ExtractorRef": "particles:ExtractorRef",
    "StructuredClaim": "particles:StructuredClaim",
    "ClaimTerm": "particles:ClaimTerm",

    "id": "@id",

    "formatVersion": { "@id": "particles:formatVersion" },
    "sourceParticleId": { "@id": "particles:sourceParticleId" },
    "sourceSubjectId": { "@id": "particles:sourceSubjectId" },

    "content": { "@id": "particles:content", "@type": "xsd:string" },
    "confidence": { "@id": "particles:confidence", "@type": "@json" },
    "confidenceValue": { "@id": "particles:confidenceValue", "@type": "xsd:float" },
    "variance": { "@id": "particles:variance", "@type": "xsd:float" },
    "calibrationSource": { "@id": "particles:calibrationSource" },
    "calibrationMethod": { "@id": "particles:calibrationMethod" },
    "calibrationRef": { "@id": "particles:calibrationRef" },
    "uncertaintyNature": { "@id": "psum:uncertaintyNature" },
    "uncertaintyKind": { "@id": "particles:uncertaintyKind" },
    "provenance": { "@id": "prov:wasDerivedFrom", "@container": "@list" },
    "refType": { "@id": "particles:refType" },
    "assertedBy": { "@id": "psum:assertedBy" },
    "assertedAt": { "@id": "particles:assertedAt", "@type": "xsd:dateTime" },
    "status": { "@id": "particles:status" },
    "statusReason": { "@id": "particles:statusReason" },
    "schemaVersion": { "@id": "particles:schemaVersion" },
    "particleType": { "@id": "particles:particleType" },
    "assertionModality": { "@id": "particles:assertionModality" },
    "validUntil": { "@id": "psum:duration", "@type": "xsd:dateTime" },
    "supersedes": { "@id": "particles:supersedes", "@type": "@id" },
    "subjectIds": { "@id": "particles:subject", "@type": "@id", "@container": "@set" },
    "subjects": { "@id": "particles:subjects", "@container": "@list" },
    "basis": { "@id": "particles:basis", "@type": "@json" },
    "extractorRef": { "@id": "particles:extractorRef" },
    "extractorName": { "@id": "particles:extractorName" },
    "extractorVersion": { "@id": "particles:extractorVersion" },
    "extractionProviderModel": { "@id": "particles:extractionProviderModel" },
    "sequenceContext": { "@id": "particles:sequenceContext", "@container": "@list" },
    "tags": { "@id": "particles:tag", "@container": "@set" },
    "contextFingerprint": { "@id": "particles:contextFingerprint" },
    "properties": { "@id": "particles:properties", "@type": "@json" },
    "contributors": { "@id": "particles:contributors", "@container": "@list" },
    "role": { "@id": "particles:role" },
    "at": { "@id": "particles:at", "@type": "xsd:dateTime" },

    "structuredClaim": { "@id": "particles:structuredClaim" },
    "canonicalForm": { "@id": "particles:canonicalForm" },
    "subject": { "@id": "rdf:subject" },
    "predicate": { "@id": "rdf:predicate" },
    "object": { "@id": "rdf:object" },
    "subjectId": { "@id": "particles:subjectId", "@type": "@id" },
    "structurizerId": { "@id": "particles:structurizerId" },
    "structurizerVersion": { "@id": "particles:structurizerVersion" },
    "generatedAt": { "@id": "particles:generatedAt", "@type": "xsd:dateTime" },
    "termKind": { "@id": "particles:termKind" },
    "termValue": { "@id": "particles:termValue" },
    "datatype": { "@id": "particles:datatype", "@type": "@id" },
    "language": { "@id": "particles:language" },

    "corpusEntryId": { "@id": "particles:corpusEntryId", "@type": "xsd:string" },
    "location": { "@id": "particles:location" },
    "chunkHash": { "@id": "particles:chunkHash" },

    "canonicalName": { "@id": "particles:canonicalName" },
    "description": { "@id": "particles:description" },
    "aliases": { "@id": "particles:alias", "@container": "@set" },
    "externalIds": { "@id": "particles:externalRef", "@container": "@set" },
    "externalRefs": { "@id": "particles:externalRef", "@container": "@set" },
    "subjectClass": { "@id": "particles:subjectClass" },

    "namespace": { "@id": "particles:namespace" },
    "externalId": { "@id": "particles:externalId" },
    "uri": { "@id": "particles:uri", "@type": "@id" },

    "entryId": { "@id": "particles:entryId" },
    "uriR": { "@id": "particles:uriR", "@type": "xsd:anyURI" },
    "sourceType": { "@id": "particles:sourceType" },
    "mutability": { "@id": "particles:mutability" },
    "fetchPolicy": { "@id": "particles:fetchPolicy" },
    "depositedBy": { "@id": "particles:depositedBy" },
    "createdAt": { "@id": "particles:createdAt", "@type": "xsd:dateTime" },
    "snapshots": { "@id": "particles:snapshot", "@container": "@list" },

    "snapshotId": { "@id": "particles:snapshotId" },
    "capturedAt": { "@id": "particles:capturedAt", "@type": "xsd:dateTime" },
    "contentHash": { "@id": "particles:contentHash" },
    "etag": { "@id": "particles:etag" },
    "lastModified": { "@id": "particles:lastModified", "@type": "xsd:dateTime" },
    "archivePath": { "@id": "particles:archivePath" },
    "refersTo": { "@id": "particles:refersTo", "@type": "@id" },
    "extractionStatus": { "@id": "particles:extractionStatus" },
    "warcRecordType": { "@id": "particles:warcRecordType" },
    "authorId": { "@id": "particles:authorId" },
    "authorRole": { "@id": "particles:authorRole" },
    "contentPublishedAt": { "@id": "particles:contentPublishedAt", "@type": "xsd:dateTime" },

    "statementId": { "@id": "particles:statementId" },
    "domain": { "@id": "particles:domain" },
    "sourceRef": { "@id": "particles:sourceRef" },
    "trustRank": { "@id": "particles:trustRank", "@type": "xsd:float" },
    "policyProvenance": { "@id": "particles:policyProvenance" },
    "reviewId": { "@id": "particles:reviewId" },

    "particleA": { "@id": "particles:particleA", "@type": "@id" },
    "particleB": { "@id": "particles:particleB", "@type": "@id" },
    "relationType": { "@id": "particles:relationType" },
    "createdBy": { "@id": "particles:createdBy" },

    "inconsistencyParticleId": { "@id": "particles:inconsistencyParticleId", "@type": "@id" },
    "resolution": { "@id": "particles:resolution" },
    "reviewerId": { "@id": "particles:reviewerId" },
    "reviewedAt": { "@id": "particles:reviewedAt", "@type": "xsd:dateTime" },
    "trustStatementId": { "@id": "particles:trustStatementId", "@type": "@id" },
    "note": { "@id": "particles:note" },

    "ALEATORY": "psum:ALEATORY",
    "EPISTEMIC": "psum:EPISTEMIC",
    "ACTIVE": "particles:ACTIVE",
    "SUPERSEDED": "particles:SUPERSEDED",
    "RETRACTED": "particles:RETRACTED",
    "PROVENANCE_STALE": "particles:PROVENANCE_STALE",
    "INCONSISTENCY": "particles:INCONSISTENCY"
  }
